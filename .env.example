APP_NAME="Smart Sukses School"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Password awal akun yang dibuat seeder (UserSeeder, Sprint4DemoSeeder).
# Sengaja dibiarkan sebagai komentar: mengisinya kosong membuat env() menghasilkan
# string kosong, bukan nilai bawaan. Aktifkan dan isi sendiri sebelum seeding di
# lingkungan mana pun selain lokal — minimal 8 karakter (Arsitektur 3.4), dan
# wajib diganti saat login pertama (users.must_change_password).
# SEED_ADMIN_PASSWORD=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smartsukses
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
HASH_DRIVER=argon2id
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Cookie sesi hanya dikirim lewat HTTPS. WAJIB true di produksi; false di lokal
# supaya pengembangan lewat http:// tetap dapat login.
SESSION_SECURE_COOKIE=false

# Proxy tepercaya (Arsitektur 3.3.1: Cloudflare -> Nginx -> PHP-FPM).
# Kosong = tidak memercayai siapa pun, dan itu benar untuk pengembangan lokal.
# Di produksi isi alamat Nginx, mis. 127.0.0.1 - lihat docs/deployment-production.md.
TRUSTED_PROXIES=

# Origin yang boleh memanggil /api/* lintas domain. Kosong = memakai APP_URL.
# JANGAN diisi "*" di produksi.
CORS_ALLOWED_ORIGINS=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
