APP_NAME="Smart Sukses School"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Password awal akun yang dibuat seeder (UserSeeder, Sprint4DemoSeeder).
# Sengaja dibiarkan sebagai komentar: mengisinya kosong membuat env() menghasilkan
# string kosong, bukan nilai bawaan. Aktifkan dan isi sendiri sebelum seeding di
# lingkungan mana pun selain lokal — minimal 8 karakter (Arsitektur 3.4), dan
# wajib diganti saat login pertama (users.must_change_password).
# SEED_ADMIN_PASSWORD=

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smartsukses
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
HASH_DRIVER=argon2id
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Cookie sesi hanya dikirim lewat HTTPS. WAJIB true di produksi; false di lokal
# supaya pengembangan lewat http:// tetap dapat login.
SESSION_SECURE_COOKIE=false

# Proxy tepercaya. Kosong = tidak memercayai siapa pun, dan itu benar untuk
# pengembangan lokal.
#
# WAJIB diisi di balik TLS terminator. Tanpa itu Laravel membaca permintaan
# HTTPS sebagai HTTP: seluruh URL absolut, action formulir, dan URL aset lahir
# ber-skema http, asetnya diblokir sebagai konten campuran, dan halaman tampil
# tanpa gaya sama sekali (butir 583).
#
#   Nginx/Cloudflare di host yang sama : TRUSTED_PROXIES=127.0.0.1
#   Platform berbasis kontainer         : TRUSTED_PROXIES=*
#
# "*" hanya sah bila origin tidak dapat dihubungi langsung dari internet.
#
# Ini menyetel lapisan Laravel saja. Pada platform yang punya proxy sendiri di
# depan aplikasi, proxy itu juga harus dikonfigurasi memercayai edge platformnya
# - kalau tidak, metadata yang diteruskan tidak pernah sampai ke sini untuk
# dinilai. Konfigurasi platformnya tidak universal dan tidak tinggal di berkas
# ini; untuk Railway lihat docs/deployment/staging-uat.md.
TRUSTED_PROXIES=

# Origin yang boleh memanggil /api/* lintas domain. Kosong = memakai APP_URL.
# JANGAN diisi "*" di produksi.
CORS_ALLOWED_ORIGINS=

BROADCAST_CONNECTION=log

# Disk bawaan Laravel. JANGAN diisi s3: jalur impor Excel memanggil
# Storage::disk('local')->path(), sebuah lintasan berkas sungguhan yang tidak
# dimiliki objek S3 (butir 585).
FILESYSTEM_DISK=local

# Disk untuk berkas privat yang harus bertahan. Kosong = memakai bawaannya,
# yaitu `local` (storage/app/private) — benar untuk lokal dan untuk server
# dengan berkas sistem yang menetap.
#
# Isi `s3` hanya pada platform yang berkas sistemnya sementara, atau ketika web
# dan worker berjalan sebagai service terpisah. PDF rapor adalah satu-satunya
# yang benar-benar dibagi dua service: ditulis worker, dibaca web.
#
# Untuk Railway lihat docs/deployment/staging-uat.md — nilainya harus disetel
# pada KEDUA service, dan kredensial bucket-nya masuk lewat referensi variabel
# Railway, tidak pernah disalin ke berkas ini.
REPORT_CARD_DISK=
PAYMENT_PROOF_DISK=
TRANSACTION_PROOF_DISK=
PPDB_PRIVATE_DISK=
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Masuk dengan Google (M7). Ketiganya kosong = fitur mati: tombolnya tidak
# muncul dan rute OAuth-nya menjawab 404.
#
# GOOGLE_REDIRECT_URI harus sama persis dengan Authorized redirect URI pada
# Google Cloud Console, termasuk skema dan port. Nilainya selalu
# <APP_URL>/masuk/google/callback.
#
# JANGAN mengisi client secret di berkas ini. Berkas ini masuk git.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/masuk/google/callback"

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Wajib untuk penyimpanan S3-compatible non-AWS (Railway Storage Bucket,
# MinIO). Nilainya, beserta benar-tidaknya AWS_USE_PATH_STYLE_ENDPOINT di atas,
# ditentukan tab Credentials milik bucket itu sendiri — jangan ditebak.
AWS_ENDPOINT=

VITE_APP_NAME="${APP_NAME}"
