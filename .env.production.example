# =============================================================================
# Contoh .env PRODUKSI — apps.smartsukses.sch.id
# =============================================================================
#
# BUKAN berkas rahasia. Setiap nilai rahasia di sini adalah PLACEHOLDER dan
# harus diganti operator di server. Jangan pernah menyalin berkas ini ke
# repository dalam keadaan terisi.
#
# Langkah pemakaian ada di docs/deployment-production.md. Setelah menyusun
# .env di server, jalankan:
#
#     php artisan app:production-check
#
# Perintah itu memeriksa konfigurasi yang benar-benar berlaku dan tidak pernah
# mencetak nilai rahasia.
# =============================================================================

APP_NAME="Smart Sukses School"
APP_ENV=production
# Isi dengan: php artisan key:generate
APP_KEY=
APP_DEBUG=false
APP_URL=https://apps.smartsukses.sch.id
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12
HASH_DRIVER=argon2id

# -----------------------------------------------------------------------------
# Akun awal
# -----------------------------------------------------------------------------
# WAJIB diisi sebelum `php artisan db:seed`. Tanpa ini seeding di produksi
# BERHENTI dengan galat — nilai cadangannya ada di dalam repository dan karena
# itu diketahui publik.
# Minimal 8 karakter (Arsitektur 3.4). Akun tetap wajib ganti kata sandi saat
# login pertama.
SEED_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Basis data
# -----------------------------------------------------------------------------
# MySQL hanya mendengarkan localhost (Arsitektur 3.3.1). Jangan pakai root.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smartsukses
DB_USERNAME=smartsukses
DB_PASSWORD=

# -----------------------------------------------------------------------------
# Sesi & keamanan cookie
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# WAJIB true: seluruh lalu lintas produksi lewat HTTPS.
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# -----------------------------------------------------------------------------
# Proxy tepercaya  (Internet -> Cloudflare -> Nginx -> PHP-FPM)
# -----------------------------------------------------------------------------
# Nginx berjalan di mesin yang sama dengan PHP-FPM, sehingga proxy langsung
# yang dilihat Laravel selalu localhost. Itulah nilai yang paling sempit dan
# paling tepat.
#
# SYARATNYA: Nginx harus memulihkan alamat klien sebenarnya dari Cloudflare
# (modul real_ip + daftar rentang Cloudflare) SEBELUM meneruskan ke PHP-FPM.
# Tanpa langkah itu, yang tercatat adalah alamat Cloudflare, bukan pengunjung.
#
# Lihat docs/deployment-production.md bagian "Proxy tepercaya".
TRUSTED_PROXIES=127.0.0.1

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Checklist go-live A.3. Kosongkan untuk memakai APP_URL, atau sebut eksplisit.
# JANGAN "*".
CORS_ALLOWED_ORIGINS=https://apps.smartsukses.sch.id

# -----------------------------------------------------------------------------
# Antrean  (WAJIB ada worker — lihat runbook)
# -----------------------------------------------------------------------------
# Generate PDF rapor sekelas dan generate tagihan massal berjalan di antrean.
# Tanpa worker, keduanya menggantung selamanya tanpa pesan galat.
QUEUE_CONNECTION=database

CACHE_STORE=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# -----------------------------------------------------------------------------
# Surel  (WAJIB — bukan log)
# -----------------------------------------------------------------------------
# Alur "kata sandi sementara wajib diganti" mengarahkan pengguna ke tautan lupa
# kata sandi. Dengan MAIL_MAILER=log tautan itu tidak pernah terkirim dan
# penggunanya terkunci. Kredensial disediakan operator.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="no-reply@smartsukses.sch.id"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Log
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=14
