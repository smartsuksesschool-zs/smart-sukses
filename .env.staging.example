# =============================================================================
# Contoh .env STAGING / UAT — staging.smartsukses.sch.id
# =============================================================================
#
# BUKAN berkas rahasia. Setiap nilai rahasia di sini adalah PLACEHOLDER dan
# harus diisi operator di server. Jangan pernah menyalin berkas ini kembali ke
# repository dalam keadaan terisi.
#
# Staging **bukan** lokal. Ia punya nama host sungguhan dan dapat dibuka siapa
# pun yang tahu alamatnya, jadi pagarnya mengikuti produksi — bukan mengikuti
# mesin pengembang. Yang berbeda hanya isinya: data sintetis, bukan data
# sekolah sungguhan.
#
# Langkah pemakaian ada di docs/deployment/staging-uat.md.
# =============================================================================

APP_NAME="Smart Sukses School"

# Menyalakan penanda "STAGING / UAT" di layar, dan mewajibkan
# SEED_ADMIN_PASSWORD sebelum seeding.
APP_ENV=staging

# Isi dengan: php artisan key:generate
APP_KEY=

# WAJIB false. Halaman galat Laravel memuat isi variabel, potongan kode, dan
# nilai konfigurasi; staging dapat dibuka dari internet.
APP_DEBUG=false

APP_URL=https://staging.smartsukses.sch.id
APP_TIMEZONE=Asia/Jakarta

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12
HASH_DRIVER=argon2id

# -----------------------------------------------------------------------------
# Akun awal
# -----------------------------------------------------------------------------
# WAJIB diisi. Sejak butir 509 seeding di lingkungan mana pun selain `local` dan
# `testing` BERHENTI bila ini kosong — nilai cadangannya ada di dalam repository
# dan karena itu diketahui publik.
#
# Kata sandi ini dipakai seluruh akun hasil seeding, termasuk akun demo
# SimulationSeeder. Sebarkan lewat jalur yang aman, jangan lewat chat atau
# dokumen bersama.
SEED_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Basis data
# -----------------------------------------------------------------------------
# Basis data TERPISAH dari produksi, di server terpisah bila memungkinkan.
# Jangan pakai root, dan jangan arahkan ke basis data produksi "sebentar saja".
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=smartsukses_staging
DB_USERNAME=smartsukses_staging
DB_PASSWORD=

# -----------------------------------------------------------------------------
# Sesi & keamanan cookie
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=false
SESSION_PATH=/
# Dibiarkan null supaya cookie terikat persis pada staging.smartsukses.sch.id
# dan tidak pernah ikut terkirim ke domain induk atau ke subdomain lain.
SESSION_DOMAIN=null
# WAJIB true bila staging dilayani lewat HTTPS (dan memang harus).
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# -----------------------------------------------------------------------------
# Proxy tepercaya
# -----------------------------------------------------------------------------
# Isi hanya bila ada reverse proxy / CDN di depan aplikasi. Kosongkan bila
# PHP-FPM dilayani langsung oleh web server di mesin yang sama tanpa proxy.
# Lihat docs/deployment-production.md bagian "Proxy tepercaya".
TRUSTED_PROXIES=127.0.0.1

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# JANGAN "*".
CORS_ALLOWED_ORIGINS=https://staging.smartsukses.sch.id

# -----------------------------------------------------------------------------
# Antrean  (worker WAJIB berjalan)
# -----------------------------------------------------------------------------
# Generate PDF rapor sekelas dan generate tagihan massal berjalan di antrean.
# Tanpa worker keduanya menggantung tanpa pesan galat — dan itu akan dilaporkan
# penguji sebagai bug aplikasi, bukan sebagai worker yang mati.
QUEUE_CONNECTION=database

CACHE_STORE=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

# -----------------------------------------------------------------------------
# Surel  (sengaja `log` di staging)
# -----------------------------------------------------------------------------
# Satu-satunya surel keluar aplikasi ini adalah tautan reset kata sandi panel.
# Dengan `log`, tautan itu ditulis ke storage/logs dan TIDAK terkirim ke alamat
# siapa pun — inilah yang mencegah penguji tanpa sengaja menyurati orang tua
# atau siswa sungguhan bila suatu saat ada alamat sungguhan di basis data.
#
# Operator mengambil tautannya dari log. Bila alur reset perlu diuji sungguhan,
# pakai penangkap surel lokal (Mailpit/MailHog) — gratis, tidak mengirim ke
# luar. Jangan arahkan staging ke SMTP produksi.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@staging.smartsukses.sch.id"
MAIL_FROM_NAME="${APP_NAME} (STAGING)"

# -----------------------------------------------------------------------------
# Log
# -----------------------------------------------------------------------------
# `debug` di staging disengaja: penguji melaporkan gejala, dan log yang lebih
# rinci mempersingkat penelusurannya. Ini aman selama APP_DEBUG=false, karena
# yang bertambah rinci adalah berkas log di server, bukan halaman galat yang
# dilihat pengunjung.
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=7
